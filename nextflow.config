/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    skimseq Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs

params {

    help                        = null

    slurm_account               = null                              // account to use on SLURM

    ///// Primary inputs
    samplesheet                 = null                              // path to samplesheet .csv file
    ref_genome                  = null                              // path to reference genome
    mito_contig                 = null                              // Name of mitochondrial contig
    
    ///// Intermediate inputs
    use_existing_cram           = true                              // Whether to use existing crams in output/results/cram, even if the work directory has been deleted
    use_existing_gvcf           = true                              // Whether to use existing crams in output/results/vcf/gvcf, even if the work directory has been deleted
    skip_cram_validation        = false                             // Whether validation of existing crams should be skipped
    skip_gvcf_validation        = false                             // Whether validation of existing gvcfs should be skipped

    ///// Parallelisation parameters
    fastq_chunk_size            = 1E6                               // number of reads .fastq files should be split into for mapping to genome
    hc_bases_per_chunk          = 5E7                               // Create GATK HaplotypeCaller intervals containing approximately this many aligned bases; integer
    jc_genotypes_per_chunk      = 1E8                               // Create GATK GenotypeGVCFs intervals containing approximately this many genotypes for joint calling; integer
    mp_bases_per_chunk          = 1E9                               // Create bcftools mpileup intervals containing approximately this many aligned bases; integer
    filt_var_per_chunk          = 1E7                               // Create filtering intervals containing approximately this many variants; integer
    split_large_intervals       = true                              // Split any intervals that are over hc_bases_per_chunk. Makes more even intervals at risk of artefacts near interval end.
    min_interval_gap            = 100                               // Minimum gap of missing data (N or no reads) between intervals to consider them separate interval

    ///// Reference genome masking for genotyping only (Not alignment)
    min_chr_length              = 5E7                               // Minimum length for a contig to be considered a chromosome; integer
    include_bed                 = null                              // Optional input bed file to just include these intervals for genotyping; path
    use_reference_hardmasks     = true                              // Use hard masks (N bases) already present in reference genome; boolean
    use_reference_softmasks     = false                             // Use soft masks (lowercase bases) already present in reference genome; boolean
    exclude_bed                 = null                              // Optional exclusion of certain intervals; path
    exclude_padding             = 0                                 // Optional padding of exclusion intervals; integer
    genotype_masked_bases       = false                             // Whether to genotype masked bases; boolean
    filter_masked_variants      = true                              // Whether to filter masked bases from vcf; boolean
    genmap_kmer_length          = 100                               // Kmer length for calculating mapability. Should be roughly close to the read lengths that will be mapped; integer
    genmap_error_tol            = 2                                 // Number of errors to tolerate in calculating mapability; integer
    genmap_thresh               = 0.99                              // Mapability threshold removes anything less than this. 1 = completely unique Kmer; float/proportion
    longdust_kmer_length        = 7                                 // Kmer length for longdust; integer
    longdust_window_size        = 5000                              // Context window length for longdust. Cannot find repeats with units longer than this; integer
    longdust_thresh             = 0.6                               // Complexity theshold for longdust; float/proportion

    ///// BWA-mem2 alignment parameters
    bwa_min_seed_length         = 19                                // minimum seed (kmer) length for seeding alignments; integer
    bwa_max_seed_occurance      = 250                               // skip seeds that occur more than N times in the reference. Lower values reduce number of reads mapping to repeats, and can resolve BWA-mem2 crashes; integer

    ///// Variant caller selection
    variant_discovery           = "gatk"                            // Variant discovery tool; can be one of 'gatk' or 'mpileup'
    genotyping                  = "use_discovered"                  // Genotyping tool; can be one of 'use_discovered' or 'pseudohaploid'

    ///// Generic variant caller parameters
    rmdup                    = true                                 // Exclude duplicate aligned reads from genotyping; logical
    minbq                    = 10                                   // Minimum base quality for genotyping; integer
    minmq                    = 20                                   // Minimum mapping quality for genotyping; integer
    min_fragment_length      = 15                                   // Minimum length of fragment (insert size)
    max_fragment_length      = 10000                                // Maximum length of fragment (insert size)
    min_aligned_length       = 30                                   // Minimum number of aligned (non-soft clipped) bases in read
    ploidy                   = 2                                    // Ploidy of the samples; integer
    output_indel             = true                                 // Whether to output indel sites; logical
    output_invariant         = false                                // Whether to output invariant sites; logical

    ///// GATK specific parameters
    hc_interval_padding         = 100                               // Pad intervals by this many bases for genotyping; integer
    hc_min_pruning              = 2                                 // Minimum support to not prune paths in the assembly graph. Setting to 1 increases sensitivity for low-coverage data; integer
    hc_min_dangling_length      = 4                                 // Minimum length of a dangling branch to attempt recovery. Smaller number increases sensitivity at expense of false positives; integer
    hc_max_reads_startpos       = 50                                // Maximum number of reads to retain per alignment start position. Increase if doing deep targetted sequencing; integer
    hc_pcr_free                 = false                             // Whether the library is PCR free, sets -pcr_indel_model 'NONE'
    hc_max_ambig_bases          = 5                                 // Maximum number of ambiguous 'N' bases allowed in read
    hc_use_softclipped_bases    = true                              // Use soft clipped bases in the reads, increases sensitivity for long indels
    heterozygosity              = 0.001                             // Heterozygosity value used to compute prior probabilities for any locus.
    heterozygosity_stdev        = 0.01                              // Standard deviation of heterozygosity for SNP and indel calling.
    indel_heterozygosity        = 1.25E-4                           // Heterozygosity for indel calling
    jc_max_alternate_alleles    = 6                                 // Maximum number of alternate alleles at a site to genotype. Any sites with more than this are not emitted.
    jc_max_alternate_to_import  = 10                                // Maximum number of alternate alleles at a site to import from genomicsdb. Any sites with more than this are not genotyped.

    ///// BCFtools specific parametrs
    mutation_rate              = 1.1e-3                             // mutation rate value used to compute prior probabilities for any locus. Increase for more sensitivity; float
    max_depth                  = 250                                // Maximum number of reads to use per file. Increase if doing deep targetted sequencing; integer


    // Post variant discovery filtering parameters
    //
    // Structure:
    // - population: controls how per-population filters are evaluated
    // - genotype: genotype-level masking before site/pop summaries are recalculated
    // - sample: sample-level exclusion thresholds
    // - each filter below can be applied at:
    //     global = across all retained samples
    //     pop    = within each population
    //
    // Variant types:
    // - snp       = variant sites with SNP alleles
    // - indel     = variant sites with indel alleles
    // - invariant = reference-only / non-variant sites
    //
    // Convention:
    // - null disables that filter for the given variant type / scope
    discovered_filter = [

        // Population-level logic used when applying per-population filters
        population: [
            min_samples_per_pop : 1,    // populations smaller than this are ignored in per-pop calculations
            n_pops_failing      : null, // absolute number of populations that must fail for site to be removed
            perc_pops_failing   : 0.9   // alternatively, proportion of populations that must fail
        ],

        // Genotype-level masking applied before recalculating INFO tags
        genotype: [
            qual   : 20,    // minimum genotype quality (GQ)
            dp_min : 1,     // minimum genotype depth (FORMAT/DP)
            dp_max : 1000   // maximum genotype depth (FORMAT/DP)
        ],

        // Sample-level filtering
        sample: [
            max_missing : 0.5 // remove samples with greater missing fraction than this
        ],

        // Minimum site QUAL
        qual: [
            global: [ snp: 30.0, indel: 30.0, invariant: null ]
        ],

        // Minimum site depth (INFO/DP)
        dp_min: [
            global: [ snp: 6, indel: 6, invariant: 6 ]
        ],

        // Lower site-depth percentile cutoff
        dp_lower_perc: [
            global: [ snp: 1.0, indel: 1.0, invariant: 1.0 ]
        ],

        // Upper site-depth percentile cutoff
        dp_upper_perc: [
            global: [ snp: 99.0, indel: 99.0, invariant: 99.0 ]
        ],

        // Minimum distance from an indel
        // Usually only applied to SNPs, where nearby indels can inflate false positives
        dist_indel: [
            global: [ snp: 5, indel: null, invariant: null ]
        ],

        // Excess heterozygosity test p-value threshold
        eh: [
            global: [ snp: null, indel: null, invariant: null ],
            pop:    [ snp: 0.05, indel: 0.05, invariant: null ]
        ],

        // Hardy-Weinberg equilibrium test p-value threshold
        hwe: [
            global: [ snp: null, indel: null, invariant: null ],
            pop:    [ snp: 0.05, indel: 0.05, invariant: null ]
        ],

        // Minor allele frequency threshold
        maf: [
            global: [ snp: null, indel: null, invariant: null ],
            pop:    [ snp: 0.05, indel: 0.05, invariant: null ]
        ],

        // Minor allele count threshold
        mac: [
            global: [ snp: null, indel: null, invariant: null ],
            pop:    [ snp: 2, indel: 2, invariant: null ]
        ],

        // Minimum number of called samples (NS)
        min_samples: [
            global: [ snp: null, indel: null, invariant: null ],
            pop:    [ snp: 1, indel: 1, invariant: null ]
        ],

        // Minimum call rate (CR = 1 - F_MISSING)
        min_callrate: [
            global: [ snp: null, indel: null, invariant: 0.5 ],
            pop:    [ snp: 0.5, indel: 0.5, invariant: 0.5 ]
        ]
    ]

    ///// Optional extra outputs
    output_unmapped_reads       = false                             // Whether to output unmapped reads as fastq; boolean
    output_cram                 = true                              // Whether to output CRAM files; boolean
    output_gvcf                 = true                              // Whether to output gvcf files; boolean
    output_unfiltered_vcf       = false                             // Whether to output unfiltered VCF files; boolean
    output_beagle_gl            = true                              // Whether to output genotype likelihoods in BEAGLE format; boolean
    //output_beagle_gp            = true                              // Whether to output genotype posterior probabilities in BEAGLE format; boolean
    //output_pseudohaploid_vcf    = true                              // Whether to output a pseudohaploid vcf; boolean

    ///// debugging options
    debug_mode                  = false                             // save all module outputs to results/modules; boolean
    rdata                       = false                             // save all data/objects from process-level R sessions as .RData files in work dir; boolean

    ///// Max resource options per task/process
    // Defaults only, expecting to be overwritten
    max_memory                  = '128.GB'
    max_cpus                    = 16
    max_time                    = '240.h'
    scratch                     = false

}


validation {

    failUnrecognisedParams      = false                             // run will fail if unrecognised parameters are given, not just give a warning

}


profiles {

    basc_modules {
        process.executor                = 'slurm'
        process.queue                   = 'batch,shortrun'
        params.slurm_account            = 'ngdsi'
        process.clusterOptions          = "--account $params.slurm_account --ntasks=1"
        params.max_memory               = '512.GB'
        params.max_time                 = '168.h'
        params.max_cpus                 = 48
        executor.queueSize              = 200
        executor.pollInterval           = '10 sec'
        executor.submitRateLimit        = '5 sec'
        params.scratch                  = true
    }
    basc_shifter {
        process.executor                = 'slurm'
        process.queue                   = 'batch,shortrun'
        params.slurm_account            = 'ngdsi'
        process.clusterOptions          = "--account $params.slurm_account --ntasks=1"
        params.max_memory               = '512.GB'
        params.max_time                 = '168.h'
        params.max_cpus                 = 48
        executor.queueSize              = 200
        executor.pollInterval           = '10 sec'
        executor.submitRateLimit        = '5 sec'
        process.module                  = 'shifter' // this runs 'module load shifter' at the start of each process job
        shifter.enabled                 = true
    }       
    test { /// this profile should always be specified last to force the minimal resource requirements
        params.samplesheet              = 'test_data/qfly/test_samplesheet.csv' // Qfly test data
        params.ref_genome               = 'test_data/qfly/test_qfly_genome.fa' // Qfly genome subset to 50-100kb
        params.mito_contig              = 'HQ130030.1'
        params.fastq_chunk_size	      	= 3000
        params.hc_bases_per_chunk       = 5E5 
        params.mp_bases_per_chunk       = 1E6 
        params.filt_var_per_chunk       = 200
        params.jc_genotypes_per_chunk   = 1E4                    
        params.use_reference_hardmasks  = true
        params.use_reference_softmasks  = false
        params.min_chr_length           = 20000
        params.include_bed              = 'test_data/qfly/include_interval.bed'
        params.exclude_bed              = 'test_data/qfly/exclude_interval.bed'
        params.output_invariant         = false
        params.snp_max_missing          = 0.5
        params.indel_max_missing        = 0.5
        params.max_memory               = '2.GB'
        params.max_time                 = '10.m'
        params.max_cpus                 = 1
        params.scratch                  = false
    }       
    debug {     
        params.rdata                    = true
        params.all_fasta                = true
        params.save_intermediate        = true
        params.debug_mode               = true
        params.scratch                  = false
    }           
    apptainer {         
        apptainer.enabled               = true
        apptainer.autoMounts            = true
        charliecloud.enabled            = false
        conda.enabled                   = false
        docker.enabled                  = false
        podman.enabled                  = false        
        shifter.enabled                 = false
        singularity.enabled             = false
    }           
    docker {            
        apptainer.enabled               = false
        charliecloud.enabled            = false
        conda.enabled                   = false
        docker.enabled                  = true
        docker.runOptions               = '-u $(id -u):$(id -g)'
        podman.enabled                  = false        
        shifter.enabled                 = false
        singularity.enabled             = false
    }           
    podman {            
        apptainer.enabled               = false
        charliecloud.enabled            = false
        conda.enabled                   = false
        docker.enabled                  = false
        podman.enabled                  = true        
        shifter.enabled                 = false
        singularity.enabled             = false
    }           
    shifter {           
        apptainer.enabled               = false
        charliecloud.enabled            = false
        conda.enabled                   = false
        docker.enabled                  = false
        podman.enabled                  = false        
        shifter.enabled                 = true
        singularity.enabled             = false
    }           
    singularity {           
        apptainer.enabled               = false
        charliecloud.enabled            = false
        conda.enabled                   = false
        docker.enabled                  = false
        podman.enabled                  = false        
        shifter.enabled                 = false
        singularity.enabled             = true
        singularity.autoMounts          = true
    }


}


process {

    // Use the param to control the scratch directive
    scratch = params.scratch

    // error handling
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 247) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }


    // Main & generic process resources
    withName: INDEX_GENOME {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 32.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    }    
    withName: INDEX_MITO {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }    

    // mask_genome subworkflow resources
    withName: EXTRACT_GENOME_MASKS {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }  
    withName: GENMAP {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 48.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }      
    withName: LONGDUST {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }     
    withName: MERGE_MASKS {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }       
    withName: SUMMARISE_MASKS {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }       
    
    // process_reads subworkflow resources
    withName: VALIDATE_FASTQ {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 1.h,   task.attempt ) }
    }
    withName: VALIDATE_CRAM {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 1.h,   task.attempt ) }
    }
    withName: REPAIR_FASTQ {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 40.GB,  task.attempt ) }
        time    = { time_scale ( 1.h,   task.attempt ) }
    }
    withName: SPLIT_FASTQ {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }   
    withName: MAP_TO_GENOME {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    }
    withName: MERGE_CRAM {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 16.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    }
    withName: EXTRACT_UNMAPPED {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 8.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    }
    withName: COUNT_CRAM_PERBASE {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    }  

    // Interval creation
    withName: SUM_COVERED_INTERVALS {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 12.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    }  
    withName: CREATE_INTERVAL_CHUNKS {
        cpus    = { cpu_scale  ( 6,     task.attempt ) }
        memory  = { mem_scale  ( 48.GB, task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    
    //GATK_SINGLE subworkflow Resources
    withName: VALIDATE_GVCF {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 1.h,   task.attempt ) }
    }
    withName: HAPLOTYPECALLER {
        cpus    = { cpu_scale  ( 2,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }


    //GATK_JOINT subworkflow Resources
    withName: COUNT_VCF_RECORDS {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }  
    withName: GENOMICSDB_IMPORT {
        cpus    = { cpu_scale  ( 6,     task.attempt ) }
        time    = { time_scale ( 24.h,   task.attempt ) }
        // NOTE: Memory is defined in the actual module for scaling based on sample number
    }
    withName: JOINT_GENOTYPE {
        cpus    = { cpu_scale  ( 2,     task.attempt ) }
        time    = { time_scale ( 24.h,   task.attempt ) }
        // NOTE: Memory is defined in the actual module for scaling based on sample number
    }    
    withName: MERGE_VCFS {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 48.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }  

    // BCFTools genotyping subworkflow
    withName: MPILEUP {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
        // NOTE: Memory is defined in the actual module for scaling based on sample number
    }    

    // Filtering subworkflow resources
    withName: CALC_DP_BOUNDS {
        cpus    = { cpu_scale  ( 2,     task.attempt ) }
        memory  = { mem_scale  ( 8.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    }
    withName: CALC_CHUNK_DP {
        cpus    = { cpu_scale  ( 2,     task.attempt ) }
        memory  = { mem_scale  ( 8.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    }
    withName: MERGE_CHUNK_DP {
        cpus    = { cpu_scale  ( 2,     task.attempt ) }
        memory  = { mem_scale  ( 8.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    }
    withName: CALC_CHUNK_MISSING {
        cpus    = { cpu_scale  ( 2,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: MERGE_CHUNK_MISSING {
        cpus    = { cpu_scale  ( 2,     task.attempt ) }
        memory  = { mem_scale  ( 8.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: EXTRACT_VCF_SITES {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: SUBSET_VCF_TO_SITES {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: FILTER_VCF {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: FILTER_VCF_SITES {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: INTERSECT_FILTERED_SITES {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: FILTER_VCF_GENOTYPES {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: FILTER_VCF_MISSING {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: CREATE_FILTER_HIST {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: PLOT_VCF_FILTERS {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 8.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    } 
    withName: PLOT_SAMPLE_FILTERS {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 8.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    } 


    
    // mito_genotyping subworkflow resources
    withName: CONSENSUS_MITO {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 8.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    }
    withName: PROCESS_CRAM_MITO {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 8.GB,  task.attempt ) }
        time    = { time_scale ( 1.h,   task.attempt ) }
    }   

    //Outputs subworkflow
    withName: CREATE_BEAGLE {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: CREATE_PSEUDOHAP {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: VCF2DIST {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    }
    withName: PLOT_ORDINATION {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 12.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }
    withName: PLOT_TREE {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 12.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }  

    // QC Subworkflow
    withName: CRAM_STATS {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 1.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    }
    withName: VCF_STATS {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 16.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    } 
    withName: FASTQC {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 10.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    }  
    withName: MULTIQC {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 8.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    }
}


plugins {
    id 'nf-schema@2.0.0'                            // create schema to validate sample sheets and pipeline parameters
}


report {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/report.html"
}


trace {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/trace.tsv"
}


dag {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/dag.html"
    verbose             = true
}


timeline {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/timeline.html"
}


// Function to ensure that resource requirements don't go beyond a maximum limit
// from: https://github.com/nf-core/tools/blob/99961bedab1518f592668727a4d692c4ddf3c336/nf_core/pipeline-template/nextflow.config#L206-L237
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

// functions to increase resources in proportion to task attempts while staying within max limits
def cpu_scale ( obj, iteration ) {
    return check_max( obj * iteration , 'cpus' )
}

def mem_scale ( obj, iteration ) {
    return check_max( obj * iteration , 'memory' )
}

def time_scale ( obj, iteration ) {
    return check_max( obj * iteration , 'time' )
}