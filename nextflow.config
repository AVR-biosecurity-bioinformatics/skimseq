/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    skimseq Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

validation {
    parametersSchema = 'nextflow_schema.json'
    // Parameters introduced by external institutional configs
    // rather than defined by skimseq.
    defaultIgnoreParams = [
        'config_profile_description',
        'config_profile_contact',
        'config_profile_url',
        'nci_gadi_project',
        'nci_gadi_storage'
    ]
    
    logging {
        unrecognisedParams = 'error'
        unrecognisedHeaders = 'error'
    }


    summary {
        beforeText = '''
    The following parameters differ from the pipeline defaults:
    '''
    }
}

outputDir = "${launchDir}/output/results"
workflow.output.mode = 'copy'
workflow.output.overwrite = true

includeConfig 'conf/resources.config'

profiles {

    /*
     * Software backends
     */

    conda {
        conda {
            enabled = true
            useMamba = false
        }

        apptainer.enabled = false
        charliecloud.enabled = false
        docker.enabled = false
        podman.enabled = false
        shifter.enabled = false
        singularity.enabled = false
        wave.enabled = false
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }

        wave {
            enabled = true
            strategy = 'conda'
        }

        charliecloud.enabled = false
        conda.enabled = false
        docker.enabled = false
        podman.enabled = false
        shifter.enabled = false
        singularity.enabled = false
    }

    docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }

        wave {
            enabled = true
            strategy = 'conda'
        }

        apptainer.enabled = false
        charliecloud.enabled = false
        conda.enabled = false
        podman.enabled = false
        shifter.enabled = false
        singularity.enabled = false
    }

    podman {
        podman.enabled = true

        wave {
            enabled = true
            strategy = 'conda'
        }

        apptainer.enabled = false
        charliecloud.enabled = false
        conda.enabled = false
        docker.enabled = false
        shifter.enabled = false
        singularity.enabled = false
    }

    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }

        wave {
            enabled = true
            strategy = 'conda'
        }

        apptainer.enabled = false
        charliecloud.enabled = false
        conda.enabled = false
        docker.enabled = false
        podman.enabled = false
        shifter.enabled = false
    }

    /*
     * Dataset and development profiles
     */

    test {
        params.samplesheet = 'test_data/qfly/test_samplesheet.csv'
        params.ref_genome = 'test_data/qfly/test_qfly_genome.fa'
        params.mito_contig = 'HQ130030.1'

        params.hc_target_sample_bases = 50000
        params.mp_target_sample_bases = 100000
        params.mito_target_sample_bases = 50000
        params.hc_chunks_per_jc = 2
        params.depth_mask_low = 0.5
        params.depth_mask_high =1.5
        params.depth_mask_fraction = 0.5
        params.exclude_reference_hardmasks = true
        params.exclude_reference_softmasks = false
        params.min_chr_length = 20000
        params.include_bed = 'test_data/qfly/include_interval.bed'
        params.exclude_bed = 'test_data/qfly/exclude_interval.bed'

        params.output_invariant = false
        process.scratch = false

        process.resourceLimits = [
            cpus:   1,
            memory: 2.GB,
            time:   10.m
        ]
    }

    debug {
        params.rdata = true
        params.debug_mode = true
        process.scratch = false
    }
}

// Scratch and error handling
process {

    errorStrategy = {
        def retryCodes = [
            75,   // custom map_to_genome remote failures due to connection congestion
            104,  // connection reset
            125,  // docker/podman
            134,  // SIGABRT
            137,  // SIGKILL (often OOM)
            139,  // SIGSEGV
            140,  // SLURM wall clock
            143,  // SIGTERM
            146,  // File system latency
            127   // File system latency
        ]

        if( task.exitStatus == null )
            return 'retry'

        // Default value of $task.exitStatus is set to Integer.MAX_VALUE in the absence of an .exitcode file 
        // this catches "terminated for an unknown reason" 
        // see https://github.com/nextflow-io/nextflow/issues/2847#issuecomment-2144844183
        if( task.exitStatus == Integer.MAX_VALUE )
            return 'retry'

        if( task.exitStatus in retryCodes )
            return 'retry'

        return 'terminate'
    }
    
    maxRetries    = 3
    maxErrors     = -1
}


plugins {
    id 'nf-schema@3.0.0'                            // create schema to validate sample sheets and pipeline parameters
    id 'nf-wave@1.22.2'
}


report {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/report.html"
}


trace {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/trace.tsv"
}


dag {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/dag.html"
    verbose             = true
}


timeline {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/timeline.html"
}
