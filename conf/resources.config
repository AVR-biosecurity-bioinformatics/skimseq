process {

    ////////////////////////////////////////////////////////////////////////////
    // Main and generic processes
    ////////////////////////////////////////////////////////////////////////////

    withName: INDEX_GENOME {
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = { 30.m  * task.attempt }
    }

    withName: INDEX_MITO {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }


    ////////////////////////////////////////////////////////////////////////////
    // mask_genome subworkflow
    ////////////////////////////////////////////////////////////////////////////

    withName: EXTRACT_GENOME_MASKS {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }

    withName: GENMAP {
        cpus   = 8
        memory = { 48.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: LONGDUST {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: NUMT_MASK {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: MERGE_MASKS {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }

    withName: SUMMARISE_MASKS {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }
   
    ////////////////////////////////////////////////////////////////////////////
    // process_reads subworkflow
    ////////////////////////////////////////////////////////////////////////////

    withName: VALIDATE_FASTQ {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    withName: VALIDATE_CRAM {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    withName: REPAIR_FASTQ {
        cpus   = 1
        memory = { 40.GB * task.attempt }
        time   = { 1.h   * task.attempt }
    }

    withName: SPLIT_FASTQ {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }

    withName: MAP_TO_GENOME {
        cpus   = 8
        memory = { 24.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    withName: MERGE_CRAM {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: EXTRACT_UNMAPPED {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }

    withName: COUNT_CRAM_PERBASE {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    ////////////////////////////////////////////////////////////////////////////
    // Interval creation
    ////////////////////////////////////////////////////////////////////////////

    withName: SUM_COVERED_INTERVALS {
        cpus   = 1
        memory = { 12.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    withName: CREATE_INTERVAL_CHUNKS {
        cpus   = 6
        memory = { 48.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }


    ////////////////////////////////////////////////////////////////////////////
    // GATK_SINGLE subworkflow
    ////////////////////////////////////////////////////////////////////////////

    withName: VALIDATE_GVCF {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    withName: HAPLOTYPECALLER {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }



    ////////////////////////////////////////////////////////////////////////////
    // GATK_JOINT subworkflow
    ////////////////////////////////////////////////////////////////////////////

    withName: COUNT_VCF_RECORDS {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: GENOMICSDB_IMPORT {
        cpus = 6
        time = { 24.h * task.attempt }

        /*
         * Memory is defined in the process/module because its initial
         * allocation scales with sample count.
         */
    }

    withName: JOINT_GENOTYPE {
        cpus = 2
        time = { 24.h * task.attempt }

        /*
         * Memory is defined in the process/module because its initial
         * allocation scales with sample count.
         */
    }

    withName: CONCAT_VCFS {
        cpus   = 8
        memory = { 48.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }


    ////////////////////////////////////////////////////////////////////////////
    // BCFtools genotyping subworkflow
    ////////////////////////////////////////////////////////////////////////////

    withName: MPILEUP {
        cpus = 4
        time = { 6.h * task.attempt }

        /*
         * Memory is defined in the process/module because its initial
         * allocation scales with sample count.
         *
         * The container is assigned separately in basc_shifter.config.
         */
    }

    ////////////////////////////////////////////////////////////////////////////
    // Filtering subworkflow
    ////////////////////////////////////////////////////////////////////////////

    withName: CALC_CHUNK_DP {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    withName: MERGE_CHUNK_DP {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    withName: MERGE_CHUNK_MISSING {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 6.h  * task.attempt }
    }

    withName: EXTRACT_VCF_SITES {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: SUBSET_VCF_TO_SITES {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: FILTER_VCF {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: CREATE_FILTER_HIST {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: PLOT_VCF_FILTERS {
        cpus   = 1
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: PLOT_SAMPLE_FILTERS {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }


    ////////////////////////////////////////////////////////////////////////////
    // mito_genotyping subworkflow
    ////////////////////////////////////////////////////////////////////////////

    withName: CONSENSUS_MITO {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }

    withName: PROCESS_CRAM_MITO {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }


    ////////////////////////////////////////////////////////////////////////////
    // Outputs subworkflow
    ////////////////////////////////////////////////////////////////////////////

    withName: SPLIT_VCF_BY_TYPE {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: CREATE_BEAGLE {
        cpus   = 1
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: VCF2DIST {
        cpus   = 8
        memory = { 48.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: PLOT_ORDINATION {
        cpus   = 1
        memory = { 12.GB * task.attempt }
        time   = { 10.m  * task.attempt }
    }

    withName: PLOT_TREE {
        cpus   = 1
        memory = { 12.GB * task.attempt }
        time   = { 10.m  * task.attempt }
    }


    ////////////////////////////////////////////////////////////////////////////
    // QC subworkflow
    ////////////////////////////////////////////////////////////////////////////

    withName: CRAM_STATS_RIKER {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    withName: VCF_STATS {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withName: MULTIQC {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

}