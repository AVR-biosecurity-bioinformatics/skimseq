//AgVic BASC configuration profile

process {
    executor = 'slurm'
    scratch=true
    queue = { task.time <= 6.h ? 'shortrun' : 'batch' }
    module = 'Miniconda3/24.7.1-0'
    beforeScript = 'sleep 10' // Forces the node to wait 10 seconds before executing
    clusterOptions = "--account ${params.slurm_account} --ntasks=1"
    maxForks=200 // Maximum 200 parallel jobs per process
    resourceLimits = [
        cpus:   48,
        memory: 512.GB,
        time:   168.h
    ]
}

executor {
    queueSize           = 200
    pollInterval        = '10 sec'
    submitRateLimit = '1/10s'  // Submit at most 1 task every 10 seconds
    perCpuMemAllocation = true
    onlyJobState        = true
    queueGlobalStatus   = true
}

conda {
    enabled  = true
    useMamba = false
}

apptainer.enabled    = false
charliecloud.enabled = false
docker.enabled       = false
podman.enabled       = false
shifter.enabled      = false
singularity.enabled  = false
wave.enabled         = false