// NCI Gadi nf-core configuration profile

// Enable use of Singularity to run containers
singularity {
    enabled = true
    autoMounts = true
    cacheDir = "/scratch/${System.getenv('PROJECT')}/${System.getenv('USER')}/nxf_singularity_cache"
}

// Submit up to 300 concurrent jobs (Gadi exec max)
executor {
    queueSize = 300
}

// Define process resource limits
process {
    executor = 'pbspro'

    // Evaluate PBS_JOBFS inside the submitted job, not on the launch node.
    scratch = '$PBS_JOBFS'

    clusterOptions = {
        [
            "-P ${System.getenv('PROJECT')}",
            "-l ncpus=${task.cpus}",
            "-l mem=${task.memory.toMega()}MB",
            "-l storage=gdata/${System.getenv('PROJECT')}+scratch/${System.getenv('PROJECT')}",
            "-l jobfs=${task.disk?.toGiga() ?: 20}GB"
        ].join(' ')
    }

    module = 'singularity'
    cache = 'lenient'
    stageInMode = 'copy'

    queue = {
        task.memory < 128.GB ? 'normalbw' :
        task.memory <= 190.GB ? 'normal' :
        task.memory <= 1020.GB ? 'hugemembw' : ''
    }
}