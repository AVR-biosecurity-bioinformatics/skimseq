// This config file is temporary, remove module definitions for processes as conda enviornment.yml are added

params {
    // Define versions of all basc modules
    basc_module_bwa_mem2 = 'bwa-mem2/2.2.1-GCC-13.3.0'
    basc_module_bedtools = 'BEDTools/2.31.1-GCC-13.3.0'
    basc_module_gatk     = 'GATK/4.6.1.0-GCCcore-13.3.0-Java-21'
    basc_module_picard   = 'picard/3.3.0-Java-21'
    basc_module_samtools = 'SAMtools/1.23.1-GCC-13.3.0'
    basc_module_bcftools = 'BCFtools/1.23.1-GCC-13.3.0'
    basc_module_seqkit   = 'SeqKit/2.8.2'
    basc_module_seqtk    = 'seqtk/1.4-GCC-13.3.0'
    basc_module_genmap   = 'GenMap/1.3.0-GCCcore-13.3.0'
    basc_module_longdust = 'longdust/1.4-GCCcore-13.3.0'
    basc_module_mummer   = 'MUMmer/4.0.1-GCCcore-13.3.0'
    basc_module_bedops   = 'BEDOPS/2.4.42-foss-2024a'
    basc_module_parallel = 'parallel/20240722-GCCcore-13.3.0'
    basc_module_pigz     = 'pigz/2.8-GCCcore-13.3.0'
    basc_module_vcf2dis  = 'VCF2Dis/1.53-GCC-13.3.0'
    basc_module_fastqc   = 'FastQC/0.12.1-Java-11'
    basc_module_multiqc  = 'MultiQC/1.33-gfbf-2024a'
    basc_module_shifter  = 'shifter/22.02.1'
}

process {

    // Main modules
    withName: INDEX_GENOME {
        module = [
            params.basc_module_bwa_mem2,
            params.basc_module_bedtools,
            params.basc_module_gatk,
            params.basc_module_picard,
            params.basc_module_samtools
        ].join(':')
    }
    withName: INDEX_MITO {
        module = [
            params.basc_module_bwa_mem2,
            params.basc_module_samtools,
            params.basc_module_seqtk
        ].join(':')
    }

    // mask_genome subworkflow resources
    withName: EXTRACT_GENOME_MASKS {
        module = [
            params.basc_module_bedtools,
            params.basc_module_seqkit
        ].join(':')
    }

    withName: GENMAP {
        module = [
            params.basc_module_genmap,
            params.basc_module_bedtools
        ].join(':')
    }

    withName: LONGDUST {
        module = [
            params.basc_module_longdust,
            params.basc_module_seqkit,
            params.basc_module_bedtools
        ].join(':')
    }
    
    withName: NUMT_MASK {
        module = [
            params.basc_module_mummer,
            params.basc_module_seqkit,
            params.basc_module_bedtools
        ].join(':')
    }

    withName: MERGE_MASKS {
        module = [
            params.basc_module_bedtools
        ].join(':')
    }

    withName: SUMMARISE_MASKS {
        module = [
            params.basc_module_bedtools
        ].join(':')
    } 
    
    // process_reads modules
    withName: VALIDATE_CRAM {
        module = [
            params.basc_module_samtools,
            params.basc_module_seqkit
        ].join(':')
    }
    withName: REPAIR_FASTQ {
        module = [
            params.basc_module_seqkit
        ].join(':')
    } 
    withName: SPLIT_FASTQ {
        module = [
            params.basc_module_seqtk
        ].join(':')
    } 
    withName: MAP_TO_GENOME {
        module = [
            params.basc_module_bwa_mem2,
            params.basc_module_samtools,
            params.basc_module_seqkit
        ].join(':')
    } 
    withName: MERGE_CRAM {
        module = [
            params.basc_module_samtools
        ].join(':')
    } 
    withName: EXTRACT_UNMAPPED {
        module = [
            params.basc_module_samtools
        ].join(':')
    } 
    withName: COUNT_CRAM_PERBASE {
        module = [
            params.basc_module_bedtools,
            params.basc_module_samtools,
            params.basc_module_bcftools
        ].join(':')
    } 

    // Interval creation modules
    withName: SUM_COVERED_INTERVALS {
        module = [
            params.basc_module_bedtools,
            params.basc_module_samtools,
            params.basc_module_bcftools
        ].join(':')
    } 
    withName: CREATE_INTERVAL_CHUNKS {
        module = [
            params.basc_module_bedtools,
            params.basc_module_bedops,
            params.basc_module_bcftools,
            params.basc_module_parallel
        ].join(':')
    } 
    
    //GATK modules
    withName: VALIDATE_GVCF {
        module = [
            params.basc_module_bcftools
        ].join(':')
    } 
    withName: HAPLOTYPECALLER {
        module = [
            params.basc_module_bcftools,
            params.basc_module_gatk,
            params.basc_module_samtools,
            params.basc_module_bedtools
        ].join(':')
    } 
    withName: COUNT_VCF_RECORDS {
        module = [
            params.basc_module_bcftools,
            params.basc_module_bedtools
        ].join(':')
    } 
    withName: GENOMICSDB_IMPORT {
        module = [
            params.basc_module_bcftools,
            params.basc_module_gatk
        ].join(':')
    } 
    withName: JOINT_GENOTYPE {
        module = [
            params.basc_module_bcftools,
            params.basc_module_bedtools,
            params.basc_module_gatk
        ].join(':')
    } 
    withName: CONCAT_VCFS {
        module = [
            params.basc_module_bcftools
        ].join(':')
    } 

    // BCFTools genotyping subworkflow
    withName: MPILEUP {
        module = [
            params.basc_module_bcftools,
            params.basc_module_bedtools,
            params.basc_module_samtools,
            params.basc_module_parallel
        ].join(':')
    } 

    // Filtering subworkflow resources
    withName: CALC_CHUNK_DP {
        module = [
            params.basc_module_bcftools,
            params.basc_module_bedtools
        ].join(':')
    } 
    withName: MERGE_CHUNK_DP {
        module = [
            params.basc_module_bcftools,
            params.basc_module_bedtools
        ].join(':')
    } 
    withName: MERGE_CHUNK_MISSING {
        module = [
            params.basc_module_bcftools,
            params.basc_module_bedtools
        ].join(':')
    } 
    withName: EXTRACT_VCF_SITES {
        module = [
            params.basc_module_bcftools
        ].join(':')
    } 
    withName: SUBSET_VCF_TO_SITES {
        module = [
            params.basc_module_bcftools
        ].join(':')
    } 
    withName: FILTER_VCF {
        module = [
            params.basc_module_bcftools,
            params.basc_module_bedtools
        ].join(':')
    } 
    withName: CREATE_FILTER_HIST {
        module = [
            params.basc_module_bcftools,
            params.basc_module_bedtools,
            params.basc_module_pigz
        ].join(':')
    } 
    withName: PLOT_VCF_FILTERS {
        module = [
            params.basc_module_shifter
        ].join(':')
    } 
    withName: PLOT_SAMPLE_FILTERS {
        module = [
            params.basc_module_shifter
        ].join(':')
    } 
    
    // mito_genotyping subworkflow resources
    withName: PROCESS_CRAM_MITO {
        module = [
            params.basc_module_samtools
        ].join(':')
    } 
    withName: CONSENSUS_MITO {
        module = [
            params.basc_module_bedtools,
            params.basc_module_samtools,
            params.basc_module_bwa_mem2,
            params.basc_module_seqkit
        ].join(':')
    } 

    //Outputs subworkflow
    withName: SPLIT_VCF_BY_TYPE {
        module = [
            params.basc_module_bcftools
        ].join(':')
    } 
    withName: CREATE_BEAGLE {
        module = [
            params.basc_module_bcftools
        ].join(':')
    } 
    withName: VCF2DIST {
        module = [
            params.basc_module_bcftools,
            params.basc_module_vcf2dis
        ].join(':')
    } 
    withName: PLOT_ORDINATION {
        module = [
            params.basc_module_shifter
        ].join(':')
    } 
    withName: PLOT_TREE {
        module = [
            params.basc_module_shifter
        ].join(':')
    } 

    // QC Subworkflow
    withName: CRAM_STATS {
        module = [
            params.basc_module_samtools
        ].join(':')
    } 
    withName: VCF_STATS {
        module = [
            params.basc_module_bcftools
        ].join(':')
    } 
    withName: FASTQC {
        module = [
            params.basc_module_samtools,
            params.basc_module_fastqc
        ].join(':')
    } 
    withName: MULTIQC {
        module = [
            params.basc_module_multiqc
        ].join(':')
    } 
}