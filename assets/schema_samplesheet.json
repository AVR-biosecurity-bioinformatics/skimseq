{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sample",
      "fwd"
    ],
    "properties": {
      "sample": {
        "type": "string",
        "minLength": 3,
        "pattern": ".*\\S.*",
        "description": "Unique sample identifier."
      },
      "lib": {
        "type": "string",
        "minLength": 3,
        "pattern": ".*\\S.*",
        "description": "Unique library identifier. Set to sample if not provided"
      },
      "pop": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*",
        "description": "Population identifier."
      },
      "fwd": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*",
        "description": "Forward FASTQ path, URL, or run accession."
      },
      "rev": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*",
        "description": "Reverse FASTQ path or URL; leave empty for accessions."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "fwd": {
              "pattern": "^(SRR|ERR|DRR)[0-9]+$"
            }
          },
          "required": [
            "fwd"
          ]
        },
        "then": {
          "not": {
            "required": [
              "rev"
            ]
          }
        },
        "else": {
          "required": [
            "rev"
          ]
        }
      }
    ]
  }
}